{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices', // pin SHA des actions (helpers:pinGitHubActionDigests), digests, sane defaults
  ],
  schedule: ['* 0-4 * * 1'], // lundi tôt — groupé, peu de bruit
  timezone: 'Europe/Zurich',
  labels: ['dependencies'],
  // Cooldown anti-supply-chain (leçon worm npm 2025) : ne pas prendre un package
  // publié il y a moins de 7 jours.
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      matchManagers: ['nuget'],
      groupName: 'nuget non-major',
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      matchManagers: ['npm'],
      groupName: 'npm non-major',
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      // hey-api pré-1.0 : breaking minors — PR séparée, jamais groupée
      matchPackageNames: ['@hey-api/openapi-ts'],
      groupName: null,
      rangeStrategy: 'bump',
    },
  ],
}
