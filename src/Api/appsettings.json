{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=saas;Username=saas;Password=saas"
  },
  "Jwt": {
    "Issuer": "saas-api",
    "Audience": "saas-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": { "AllowedOrigins": [ "http://localhost:4200" ] },
  "App": { "BaseUrl": "http://localhost:4200" },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "no-reply@saas.local",
    "FromName": "Saas",
    "UseStartTls": false,
    "UseSslOnConnect": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "Database": { "MigrateOnStartup": true },
  "RequestTimeouts": { "DefaultSeconds": 30 },
  "DataProtection": { "KeysPath": "" },
  "ForwardedHeaders": { "Enabled": false },
  "AllowedHosts": "*"
}
