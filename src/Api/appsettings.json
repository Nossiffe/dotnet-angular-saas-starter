    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "no-reply@saas.local",
    "FromName": "Saas",
    "UseStartTls": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
