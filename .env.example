# Base de données
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
POSTGRES_DB=saas
POSTGRES_PORT=5432

# Outils dev
ADMINER_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Email transactionnel (SMTP) — en dev pointe Mailpit (host=localhost, port=1025, sans TLS/auth)
Email__Host=localhost
Email__Port=1025
Email__FromAddress=no-reply@saas.local
Email__FromName=Saas
Email__UseStartTls=false

# Base URL du front pour les liens email (confirmation / reset password)
App__BaseUrl=http://localhost:4200

# Connection string utilisée par l'API (.NET)
DATABASE_URL=Host=localhost;Port=5432;Database=saas;Username=saas;Password=saas

# Connection string en lecture seule pour le MCP dbhub (doit pointer un rôle Postgres sans droits d'écriture)
# En dev, peut pointer la même base que DATABASE_URL (pas de rôle séparé requis localement)
DATABASE_READONLY_URL=Host=localhost;Port=5432;Database=saas;Username=saas;Password=saas

# Compte de test seedé (utilisé par scripts/smoke.sh au Plan 5)
SEED_TEST_EMAIL=dev@saas.local
SEED_TEST_PASSWORD=Dev!12345

# OpenTelemetry (optionnel — dev avec Aspire Dashboard)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=saas-api
ASPIRE_UI_PORT=18888
OTLP_PORT=4317
