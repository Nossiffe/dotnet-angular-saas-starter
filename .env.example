# Base de données
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
POSTGRES_DB=saas
POSTGRES_PORT=5432

# Outils dev
ADMINER_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Email transactionnel (SMTP) — en dev pointe Mailpit (host=localhost, port=1025, sans TLS/auth)
Email__Host=localhost
Email__Port=1025
Email__FromAddress=no-reply@saas.local
Email__FromName=Saas
Email__UseStartTls=false
# Mettre à true pour les providers SMTP sur le port 465 (TLS implicite, ex. SendGrid, Brevo)
Email__UseSslOnConnect=false

# Base URL du front pour les liens email (confirmation / reset password)
App__BaseUrl=http://localhost:4200

# Connection string des outils EF Core au design time (dotnet ef migrations)
DATABASE_URL=Host=localhost;Port=5432;Database=saas;Username=saas;Password=saas

# OpenTelemetry (optionnel — dev avec Aspire Dashboard)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=saas-api
ASPIRE_UI_PORT=18888
OTLP_PORT=4317

# API conteneurisée (docker compose --profile full) — port et clé de dev
API_PORT=5123
APP_BASEURL=http://localhost:4200
# Clé JWT de l'API conteneurisée, développement seulement (≥ 32 caractères)
JWT_SIGNING_KEY=dev-only-change-me-0123456789abcdef
