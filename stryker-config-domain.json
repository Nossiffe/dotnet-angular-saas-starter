{
  "stryker-config": {
    "solution": "Saas.slnx",
    "project": "Saas.Domain.csproj",
    "test-projects": [
      "src/tests/UnitTests/Saas.UnitTests.csproj"
    ],
    "mutate": [
      "**/*.cs",
      "!**/Migrations/**/*.cs",
      "!**/*.g.cs"
    ],
    "coverage-analysis": "off",
    "reporters": ["html", "progress"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    }
  }
}
