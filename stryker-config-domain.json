{
  "stryker-config": {
    "project": "Saas.Domain.csproj",
    "test-runner": "mtp",
    "mutate": [
      "**/*.cs",
      "!**/*.g.cs"
    ],
    "coverage-analysis": "off",
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    }
  }
}
