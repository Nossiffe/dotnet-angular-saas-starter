{
  "name": "web-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run api:gen",
    "start": "ng serve",
    "build": "ng build",
    "prewatch": "npm run api:gen",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run api:gen",
    "test": "ng test",
    "pretest:coverage": "npm run api:gen",
    "test:coverage": "ng test --coverage",
    "api:gen": "openapi-ts",
    "prebuild": "npm run api:gen",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "fix": "prettier --write . && ng lint --fix && stylelint \"src/**/*.scss\" --fix",
    "check": "npm run api:gen && prettier --check . && ng lint && stylelint \"src/**/*.scss\" && npm run typecheck",
    "e2e": "playwright test",
    "e2e:backend": "playwright test -c playwright.backend.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "~0.99.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser@1.4.4": {
      "js-yaml": "^4.3.2"
    }
  }
}
