  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "required": ["invitationId", "token", "password"],
        "type": "object",
        "properties": {
          "invitationId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          },
          "password": {
            "type": ["null", "string"]
          }
        }
      },
      "AcceptInvitationResponse": {
        "required": ["isNewUser"],
        "type": "object",
        "properties": {
          "isNewUser": {
            "type": "boolean"
          }
        }
      },
      "AuthResponse": {
        "required": ["accessToken", "expiresAt", "refreshToken"],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "ChangeMemberRoleRequest": {
        "required": ["role"],
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          }
        }
      },
      "ConfirmEmailRequest": {
        "required": ["userId", "token"],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "CreateProductCommand": {
        "required": ["name", "price"],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          }
        }
      },
      "CreateProductResponse": {
        "required": ["id"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ForgotPasswordRequest": {
        "required": ["email"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "InvitationDto": {
        "required": ["id", "email", "role", "expiresAt", "createdAt"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InviteMemberRequest": {
        "required": ["email", "role"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "InviteResponse": {
        "required": ["invitationId"],
        "type": "object",
        "properties": {
          "invitationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LoginCommand": {
        "required": ["email", "password", "tenantId"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "tenantId": {
            "type": ["null", "string"],
            "format": "uuid"
          }
        }
      },
      "LogoutRequest": {
        "required": ["refreshToken"],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "PagedResultOfProductDto": {
        "required": ["items", "page", "pageSize", "totalCount"],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductDto"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "totalPages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          }
        }
      },
      "ProductDto": {
        "required": ["id", "name", "price"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          }
        }
      },
      "RefreshTokenCommand": {
        "required": ["refreshToken"],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RegisterCommand": {
        "required": ["email", "password"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterResponse": {
        "required": ["id"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ResetPasswordRequest": {
        "required": ["userId", "token", "newPassword"],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "UpdateProductBody": {
        "required": ["name", "price"],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Invitations"
    },
    {
      "name": "Members"
    },
    {
      "name": "Products"
    }
  ]
}
